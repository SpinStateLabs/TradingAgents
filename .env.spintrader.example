# SpinTrader configuration.
#
# Copy to `.env` and fill in. `.env` is gitignored and must stay that way --
# it holds live trading credentials.
#
# ---------------------------------------------------------------------------
# SAFETY: read this before setting SPINTRADER_LIVE_ENABLED
# ---------------------------------------------------------------------------
# Live order flow requires BOTH of the following, and neither defaults on:
#   1. SPINTRADER_LIVE_ENABLED=true
#   2. the venue listed in SPINTRADER_LIVE_VENUES
# The per-order and per-day notional caps below apply on top of all strategy
# sizing and are the last line of defence against a sizing bug. Keep them small
# until the walk-forward and paper results justify raising them.
# ---------------------------------------------------------------------------

# --- run mode ---
# backtest | paper | live
SPINTRADER_MODE=paper
# conservative | moderate | balanced | growth | aggressive
SPINTRADER_AGGRESSION=moderate
SPINTRADER_BASE_CURRENCY=USD
SPINTRADER_LOG_LEVEL=INFO
SPINTRADER_DRY_RUN=false

# --- paper/live fidelity ---
# IBKR seeds paper accounts with 1,000,000 CAD on 3.33x margin, against a real
# account holding ~100 USD of settled cash. Sizing against the reported paper
# equity validates strategies that cannot actually be run. Set this to your
# real capital so simulated results describe a book you could hold.
# Applies in paper and backtest only; live always trusts the venue.
SPINTRADER_PAPER_EQUITY=100
# Enforce cash-account rules (no leverage, no shorting, settled funds only)
# even where the venue would allow more.
SPINTRADER_ENFORCE_CASH_ACCOUNT=true

# --- live arming (leave off until proven) ---
SPINTRADER_LIVE_ENABLED=false
# comma separated: kraken,ibkr
SPINTRADER_LIVE_VENUES=
SPINTRADER_KRAKEN_MAX_ORDER=25
SPINTRADER_KRAKEN_MAX_DAILY=150
SPINTRADER_IBKR_MAX_ORDER=10
SPINTRADER_IBKR_MAX_DAILY=50

# --- local LLM on the GB10 ---
SPINTRADER_OLLAMA_URL=http://10.0.0.62:11434
SPINTRADER_QUICK_MODEL=qwen3:30b-a3b
SPINTRADER_DEEP_MODEL=MichelRosselli/GLM-4.5-Air:Q6_K
SPINTRADER_EMBED_MODEL=nomic-embed-text
SPINTRADER_LLM_TIMEOUT=300
SPINTRADER_LLM_RETRIES=3
SPINTRADER_LLM_TEMPERATURE=0.3
SPINTRADER_MAX_LLM_CALLS=120
SPINTRADER_MAX_LLM_TOKENS=1500000

# --- storage (TimescaleDB on the GB10) ---
# The database runs in docker on the GB10, published on 5433 (not 5432, so it
# cannot collide with a local postgres).
SPINTRADER_DB_HOST=10.0.0.62
SPINTRADER_DB_PORT=5433
SPINTRADER_DB_NAME=spintrader
SPINTRADER_DB_USER=spintrader
SPINTRADER_DATA_ROOT=/home/spinner/data/spintrader

# Password: prefer the FILE form. The provisioning script generated a random
# password on the GB10 and left it at the path below, so the value never has to
# be copied anywhere -- not into this file, not through a chat, not into a
# shell environment where child processes can read it.
#
# Running ON the GB10 (this is the normal case -- the trading loop lives there):
SPINTRADER_DB_PASSWORD_FILE=/home/spinner/spintrader/.pgpass_value
#
# Running from the Windows dev box, where that file is not present, read it once
# with:  ssh spinner@10.0.0.62 'cat ~/spintrader/.pgpass_value'
# then set the inline form instead and leave the FILE form blank:
SPINTRADER_DB_PASSWORD=

# --- universe ---
SPINTRADER_CRYPTO_UNIVERSE=BTC-USD,ETH-USD,SOL-USD,BNB-USD
SPINTRADER_EQUITY_UNIVERSE=SPY,QQQ,AAPL,MSFT,NVDA

# --- venue credentials ---
# Kraken: Kraken Pro -> profile icon -> Settings -> API -> Create API key.
#
# Tick EXACTLY these six permissions and nothing else:
#   Funds           : Query Funds
#   Orders & Trades : Query Open Orders & Trades
#                     Query Closed Orders & Trades
#                     Modify Orders            <- this is what places orders
#                     Cancel/Close Orders
#   Other           : Access WebSockets API    <- needed for live price streams
#
# Leave "Deposit Funds" and "Withdraw Funds" UNTICKED. The platform never moves
# money off the exchange, and a key without withdrawal permission cannot drain
# the account even if it leaks. This is the single most important setting here.
#
# Nonce window: set 5000 (ms). Zero causes spurious "invalid nonce" errors when
# concurrent requests arrive out of order; very large values weaken replay
# protection for no benefit at this request volume.
#
# IP restriction: set it to the public IP of the GB10, which is where the
# trading loop actually runs. Check it with:  curl -s ifconfig.me
# Skip this only if your ISP rotates your address.
#
# Verify the key with:  python ops/check_kraken.py
KRAKEN_API_KEY=
KRAKEN_API_SECRET=

# IBKR: the Gateway runs in docker ON THE GB10 (native arm64), so the app
# connects over localhost. Login credentials do NOT live here -- they go in
# ~/spintrader/.ibkr via ops/set_ibkr_creds.sh, which the container reads.
#
# Ports: 4002 = paper Gateway, 4001 = live Gateway
#        7497 = paper TWS,     7496 = live TWS
# The check script warns if the account type does not match the port.
IBKR_HOST=127.0.0.1
IBKR_PORT=4002
IBKR_CLIENT_ID=17
# Optional: pin a specific account id (DU... paper, U... live). Leave blank to
# use whichever account the Gateway reports.
IBKR_ACCOUNT=
